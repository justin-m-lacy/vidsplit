{
  "name": "vidsplit",
  "version": "0.7.1",
  "description": "Electron Video Splitter",
  "main": "app/main.js",
  "type": "module",
  "keywords": [
    "video",
    "video splitter",
    "typescript",
    "electron"
  ],
  "author": "justin lacy",
  "build": {
    "appId": "vidsplit.jmlacy",
    "buildVersion": "0.7.1",
    "extraFiles": [],
    "executableName": "VidSplit",
    "files": [
      "app/**/*",
      "!.vscode/**/*",
      "index.html"
    ],
    "electronLanguages": [
      "en-US"
    ]
  },
  "scripts": {
    "dev": "vite",
    "run": "electron .",
    "preview": "vite preview",
    "app:dir": "pnpm dlx electron-builder --dir",
    "app:win": "electron-builder --win --x64 --publish never",
    "app:linux": "electron-builder --linux --x64 --publish never",
    "buildrun": "pnpm build && pnpm run run",
    "build": "pnpm buildweb && pnpm buildapp",
    "buildapp": "pnpm buildnode && pnpm buildpreload",
    "buildnode": "esbuild electron/main.ts --format=esm --tsconfig=tsconfig.node.json --platform=node --bundle --outdir=app --packages=external",
    "buildpreload": "esbuild electron/preload.ts --format=cjs --platform=node --outdir=app --packages=external",
    "buildweb": "vite build",
    "test-ffmpeg": "tsx test-ffmpeg.ts"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/cli-plugin-typescript": "~5.0.8",
    "@vueuse/core": "^10.11.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "electron": "41.0.3",
    "electron-builder": "^26.8.1",
    "electron-squirrel-startup": "^1.0.1",
    "esbuild": "^0.25.4",
    "eslint": "^9.23.0",
    "lucide-vue-next": "^0.469.0",
    "pinia": "^2.3.1",
    "rimraf": "^5.0.10",
    "tailwindcss": "^4.1.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.5.2",
    "unplugin-auto-import": "^0.16.7",
    "vite": "^6.3.3",
    "vite-auto-import-resolvers": "^3.2.1",
    "vite-plugin-html": "^3.2.2",
    "vue": "^3.5.14"
  },
  "packageManager": "pnpm@9.14.2+sha512.6e2baf77d06b9362294152c851c4f278ede37ab1eba3a55fda317a4a17b209f4dbb973fb250a77abc463a341fcb1f17f17cfa24091c4eb319cda0d9b84278387"
}